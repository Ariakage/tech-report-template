}

\pgfplotsset{
  hcaxis/.style={
    width=0.98\linewidth,
    height=0.68\linewidth,
    cycle list name=hcPlotCycle,
    axis x line*=bottom,
    axis y line*=left,
    axis line style={hcMuted!70!hcSurface, line width=0.6pt},
    tick style={hcMuted!70!hcSurface, line width=0.5pt},
    tick label style={font=\sffamily\fontsize{7.2}{8.6}\selectfont, color=hcMuted},
    label style={font=\sffamily\bfseries\fontsize{8.0}{9.4}\selectfont, color=hcPrimaryDark},
