%% =============================================================================
%% style/healthcard.sty — AkaTechReport Health-Card / Header-Card Academic Style
%% =============================================================================
%% Version       : v1.2 (English / Chinese / Bilingual Modes + Rich Metadata)
%% Default Theme : akatechreport (#5BCEFA Sky Cyan, #F5A9B8 Blossom Pink, #FFFFFF)
%%                 + 6 built-in themes (claude, apple, ocean, sage, lavender, mono)
%%                 & one-line custom hex theming via \hcsettheme{primary=..., accent=...}.
%% Languages     : lang=en        Pure English (default; 100% pdfLaTeX / arXiv
%%                                Type 1 safe, zero CJK overhead).
%%                 lang=zh        Pure Chinese (XeLaTeX/LuaLaTeX via TeX Live
%%                                FandolSong/FandolHei/FandolKai, plus pdfLaTeX
%%                                CJKutf8 fallback).
%%                 lang=bilingual Chinese + English bilingual Header Card,
%%                                paired prose helpers & localized UI chrome.
%% Engine        : Uses ONLY TeX Live built-in packages. ZERO -shell-escape.
%% Layout        : Native ACM acmart ([sigconf, nonacm] two-column or 1-column),
%%                 plus standard article class fallback. All layout widths use
%%                 relative units (\textwidth, \linewidth).
%% =============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style/healthcard}[2026/11/21 v1.2 AkaTechReport Multilingual Paper Template]

%% -----------------------------------------------------------------------------
%% 1. Package Options (via xkeyval, built into TeX Live & acmart)
%% -----------------------------------------------------------------------------
\RequirePackage{iftex}
\RequirePackage{xkeyval}
\RequirePackage{etoolbox}
\RequirePackage{xstring}

\newif\ifhc@orcid@official \hc@orcid@officialfalse
\newif\ifhc@ribbon@gradient \hc@ribbon@gradienttrue
\newif\ifhc@ribbon@stripe \hc@ribbon@stripefalse
\newif\ifhc@ribbon@none \hc@ribbon@nonefalse
\newif\ifhc@accent@flip \hc@accent@flipfalse
\newif\ifhc@header@clean \hc@header@cleanfalse
\newif\ifhc@theme@apple \hc@theme@applefalse
\newif\ifhc@theme@claude \hc@theme@claudefalse
\newif\ifhc@layout@healthcard \hc@layout@healthcardtrue
\newif\ifhc@acmart \hc@acmartfalse

%% Language mode flags (default: pure English)
\newif\ifhc@lang@en \hc@lang@entrue
\newif\ifhc@lang@zh \hc@lang@zhfalse
\newif\ifhc@lang@bi \hc@lang@bifalse
\newif\ifhc@cjk \hc@cjkfalse
\newif\ifhc@bi@enzh \hc@bi@enzhfalse

\def\hc@themename{akatechreport}
\def\hc@cjkfontset{fandol}

\@ifclassloaded{acmart}{\hc@acmarttrue}{\hc@acmartfalse}

\DeclareOptionX{theme}[akatechreport]{\def\hc@themename{#1}}
\DeclareOptionX{lang}[en]{%
  \hc@lang@enfalse\hc@lang@zhfalse\hc@lang@bifalse\hc@cjkfalse
  \IfStrEqCase{#1}{%
    {zh}{\hc@lang@zhtrue\hc@cjktrue}%
    {cn}{\hc@lang@zhtrue\hc@cjktrue}%
    {bilingual}{\hc@lang@bitrue\hc@cjktrue}%
    {bi}{\hc@lang@bitrue\hc@cjktrue}%
    {zh-en}{\hc@lang@bitrue\hc@cjktrue\hc@bi@enzhfalse}%
    {en-zh}{\hc@lang@bitrue\hc@cjktrue\hc@bi@enzhtrue}%
  }[\hc@lang@entrue]%
}
\DeclareOptionX{biorder}[zh-en]{%
  \IfStrEq{#1}{en-zh}{\hc@bi@enzhtrue}{\hc@bi@enzhfalse}%
}
\DeclareOptionX{cjkfont}[fandol]{\def\hc@cjkfontset{#1}}
\DeclareOptionX{orcid}[brand]{%
  \IfStrEq{#1}{official}{\hc@orcid@officialtrue}{\hc@orcid@officialfalse}%
}
\DeclareOptionX{ribbon}[gradient]{%
  \hc@ribbon@gradientfalse\hc@ribbon@stripefalse\hc@ribbon@nonefalse
  \IfStrEq{#1}{stripe}{\hc@ribbon@stripetrue}{%
    \IfStrEq{#1}{none}{\hc@ribbon@nonetrue}{\hc@ribbon@gradienttrue}%
  }%
}
\DeclareOptionX{accent}[blue]{%
  \IfStrEq{#1}{pink}{\hc@accent@fliptrue}{\hc@accent@flipfalse}%
}
\DeclareOptionX{headerstyle}[layered]{%
  \IfStrEq{#1}{clean}{\hc@header@cleantrue}{\hc@header@cleanfalse}%
}
\ProcessOptionsX\relax

%% -----------------------------------------------------------------------------
%% 2. Standard TeX Live Packages & Engine-Aware CJK Typography (Zero -shell-escape)
%% -----------------------------------------------------------------------------
\ifhc@acmart
  %% acmart already loads: geometry, xcolor, hyperref, booktabs, caption,
  %% fancyhdr, microtype, amsmath, amsthm, natbib, libertine, zi4, newtxmath
  %% (or fontspec + unicode-math + OpenType libertine under XeTeX/LuaTeX),
  %% environ, graphicx, balance.
  \ifXeTeX
    \microtypesetup{protrusion=true}
  \else
    \microtypesetup{protrusion=true, expansion=true}
  \fi
\else
  \ifPDFTeX
    \RequirePackage[T1]{fontenc}
    \RequirePackage[utf8]{inputenc}
    \RequirePackage{amsmath, amsthm}
    \RequirePackage[tt=false, type1=true]{libertine}
    \RequirePackage[varqu]{zi4}
    \RequirePackage[libertine]{newtxmath}
    \RequirePackage[protrusion=true, expansion=true]{microtype}
  \else
    \RequirePackage{amsmath, amsthm}
    \RequirePackage{fontspec}
    \RequirePackage[tt=false]{libertine}
    \RequirePackage[varqu]{zi4}
    \ifXeTeX
      \RequirePackage[protrusion=true]{microtype}
    \else
      \RequirePackage[protrusion=true, expansion=true]{microtype}
    \fi
  \fi
  \RequirePackage[
    letterpaper,
    top=0.8in, bottom=0.88in,
    left=0.72in, right=0.72in,
    columnsep=0.28in,
    headheight=20pt, headsep=12pt, footskip=24pt
  ]{geometry}
  \RequirePackage{xcolor}
  \RequirePackage{graphicx}
  \RequirePackage{booktabs}
  \RequirePackage{caption}
  \RequirePackage{fancyhdr}
  \RequirePackage{environ}
  \RequirePackage[numbers, sort&compress]{natbib}
  \RequirePackage{balance}
  \RequirePackage[bookmarksnumbered, unicode]{hyperref}
\fi

%% Engine-aware Chinese typography (loaded ONLY when lang=zh or lang=bilingual)
\ifhc@cjk
  \ifXeTeX
    \RequirePackage[CJKchecksingle, AutoFakeSlant=0.16]{xeCJK}
    \xeCJKsetup{%
      PunctStyle=quanjiao,
      AllowBreakBetweenPuncts=true,
      CJKecglue={\hskip 0.22em plus 0.08em minus 0.05em}
    }
    \newcommand{\hc@setxecjk@fandol}{%
      \setCJKmainfont[%
        Scale=0.92,
        BoldFont=FandolSong-Bold.otf,
        ItalicFont=FandolKai-Regular.otf,
        BoldItalicFont=FandolSong-Bold.otf
      ]{FandolSong-Regular.otf}%
      \setCJKsansfont[%
        Scale=0.92,
        BoldFont=FandolHei-Bold.otf,
        ItalicFont=FandolHei-Regular.otf,
        BoldItalicFont=FandolHei-Bold.otf
      ]{FandolHei-Regular.otf}%
      \setCJKmonofont[%
        Scale=0.90,
        BoldFont=FandolHei-Regular.otf
      ]{FandolFang-Regular.otf}%
    }
    \IfStrEqCase{\hc@cjkfontset}{%
      {none}{}%
      {mac}{%
        \setCJKmainfont[Scale=0.92, BoldFont=Songti SC Bold, ItalicFont=Kaiti SC Regular, BoldItalicFont=Kaiti SC Bold]{Songti SC Regular}%
        \setCJKsansfont[Scale=0.92, BoldFont=PingFang SC Semibold]{PingFang SC Regular}%
        \setCJKmonofont[Scale=0.90]{STFangsong}%
      }%
      {windows}{%
        \setCJKmainfont[Scale=0.92, AutoFakeBold=2.2, ItalicFont=KaiTi]{SimSun}%
        \setCJKsansfont[Scale=0.92, AutoFakeBold=2.0]{Microsoft YaHei}%
        \setCJKmonofont[Scale=0.90]{FangSong}%
      }%
      {ubuntu}{%
        \setCJKmainfont[Scale=0.92, BoldFont=Noto Serif CJK SC Bold]{Noto Serif CJK SC}%
        \setCJKsansfont[Scale=0.92, BoldFont=Noto Sans CJK SC Bold]{Noto Sans CJK SC}%
        \setCJKmonofont[Scale=0.90]{Noto Sans Mono CJK SC}%
      }%
    }[\hc@setxecjk@fandol]
  \else\ifLuaTeX
    \RequirePackage{luatexja-fontspec}
    \newcommand{\hc@setluacjk@fandol}{%
      \setmainjfont[Scale=0.92, BoldFont=FandolSong-Bold.otf, ItalicFont=FandolKai-Regular.otf]{FandolSong-Regular.otf}%
      \setsansjfont[Scale=0.92, BoldFont=FandolHei-Bold.otf]{FandolHei-Regular.otf}%
      \setmonojfont[Scale=0.90]{FandolFang-Regular.otf}%
    }
    \IfStrEqCase{\hc@cjkfontset}{%
      {none}{}%
      {mac}{%
        \setmainjfont[Scale=0.92, BoldFont=Songti SC Bold, ItalicFont=Kaiti SC Regular]{Songti SC Regular}%
        \setsansjfont[Scale=0.92, BoldFont=PingFang SC Semibold]{PingFang SC Regular}%
        \setmonojfont[Scale=0.90]{STFangsong}%
      }%
    }[\hc@setluacjk@fandol]
  \else
    %% pdfLaTeX fallback via TeX Live built-in CJKutf8 + Arphic Type 1 gbsn
    \RequirePackage{CJKutf8}
    \AtEndPreamble{\hc@sync@pdfmetadata}
    \AddToHook{begindocument/end}{\begin{CJK*}{UTF8}{gbsn}}
    \AddToHook{enddocument}{\clearpage\end{CJK*}}
  \fi\fi
  %% Comfortable inter-line rhythm for article class (acmart forbids \linespread)
  \ifhc@acmart\else
    \ifhc@lang@zh
      \linespread{1.15}
    \else
      \linespread{1.06}
    \fi
  \fi
\fi

%% Uppercase helper: uppercase Latin labels in Health-Card & Claude EN modes; Title Case on Apple
\newcommand{\hc@maybecaps}[1]{%
  \ifhc@theme@apple
    #1%
  \else
    \ifhc@lang@en\MakeUppercase{#1}\else#1\fi
  \fi
}

