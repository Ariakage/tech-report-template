\DeclareRobustCommand{\hc@secnumbadge}[1]{%
  \ifhc@theme@claude
    {\rmfamily\bfseries\fontsize{11.8}{14.6}\selectfont\color{hcPrimary}#1}\hspace{0.52em}%
  \else\ifhc@theme@apple
    {\sffamily\bfseries\fontsize{11.5}{14.2}\selectfont\color{hcMuted}#1}\hspace{0.48em}%
  \else
    \tcbox[
      on line, enhanced,
      colback=hcSecNumBg,
      colframe=hcSecNumBorder,
      boxrule=0.45pt,
      arc=3pt,
      boxsep=0pt,
      left=4pt, right=4pt, top=1.5pt, bottom=1.5pt,
      nobeforeafter, tcbox raise base
    ]{\sffamily\bfseries\fontsize{8.8}{10}\selectfont\color{hcSecNumInk}#1}%
    \hspace{0.48em}%
  \fi\fi
}

\DeclareRobustCommand{\hc@subsecnum}[1]{%
  {\sffamily\bfseries\color{hcSubsecNumInk}#1}\hspace{0.48em}%
}

\DeclareRobustCommand{\hc@subsubsecnum}[1]{%
  {\sffamily\bfseries\color{hcSubsubsecNumInk}#1}\hspace{0.42em}%
}

\DeclareRobustCommand{\hc@formatseccnt}[2]{%
  \IfStrEq{#1}{section}{%
    \hc@secnumbadge{#2}%
  }{%
    \IfStrEq{#1}{subsection}{%
      \hc@subsecnum{#2}%
    }{%
      \hc@subsubsecnum{#2}%
    }%
  }%
}

\def\@seccntformat#1{\hc@formatseccnt{#1}{\csname the#1\endcsname}}

\ifhc@acmart
  \def\@secfont{\hc@sec@font\color{hcSectionInk}\section@raggedright}
  \def\@subsecfont{\sffamily\bfseries\fontsize{9.6}{12.4}\selectfont\color{hcInk}\section@raggedright}
  \def\@subsubsecfont{\sffamily\bfseries\fontsize{8.9}{11.4}\selectfont\color{hcSubsubsecNumInk}}
  \def\@parfont{\sffamily\bfseries\fontsize{8.9}{11.4}\selectfont\color{hcInk}}
\else
  \RequirePackage{titlesec}
  \titleformat{\section}{\hc@sec@font\color{hcSectionInk}}{\hc@secnumbadge{\thesection}}{0pt}{}
  \titleformat{\subsection}{\sffamily\bfseries\fontsize{9.6}{12.4}\selectfont\color{hcInk}}{\hc@subsecnum{\thesubsection}}{0pt}{}
  \titleformat{\subsubsection}[runin]{\sffamily\bfseries\fontsize{8.9}{11.4}\selectfont\color{hcSubsubsecNumInk}}{\hc@subsubsecnum{\thesubsubsection}}{0pt}{}[.]
  \titleformat{\paragraph}[runin]{\sffamily\bfseries\fontsize{8.9}{11.4}\selectfont\color{hcInk}}{}{0pt}{}[.]
  \titlespacing*{\section}{0pt}{10pt plus 2pt minus 2pt}{4pt plus 1pt}
  \titlespacing*{\subsection}{0pt}{8pt plus 2pt minus 1pt}{3pt plus 1pt}
\fi

