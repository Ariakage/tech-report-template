%% -----------------------------------------------------------------------------
\newbox\hc@titlebox

\newcommand{\hc@drawribbon}{%
  \ifhc@ribbon@gradient
    \begin{scope}
      \ifhc@theme@apple
        \clip[rounded corners=9pt] (frame.south west) rectangle (frame.north east);
        \shade[shading=hcRibbonGrad]
          ([yshift=-1.8pt]frame.north west) rectangle (frame.north east);
      \else\ifhc@theme@claude
        \clip[rounded corners=6.5pt] (frame.south west) rectangle (frame.north east);
        \shade[shading=hcRibbonGrad]
          ([yshift=-2.2pt]frame.north west) rectangle (frame.north east);
      \else
        \clip[rounded corners=9pt] (frame.south west) rectangle (frame.north east);
        \shade[shading=hcRibbonGrad]
          ([yshift=-3.6pt]frame.north west) rectangle (frame.north east);
      \fi\fi
    \end{scope}
  \else\ifhc@ribbon@stripe
    \begin{scope}
      \ifhc@theme@claude
        \clip[rounded corners=6.5pt] (frame.south west) rectangle (frame.north east);
      \else
        \clip[rounded corners=9pt] (frame.south west) rectangle (frame.north east);
      \fi
      \fill[hcPrimary] ([yshift=-3.6pt]frame.north west)
        rectangle ($(frame.north west)!0.20!(frame.north east)$);
      \fill[hcAccent] ($([yshift=-3.6pt]frame.north west)!0.20!([yshift=-3.6pt]frame.north east)$)
        rectangle ($(frame.north west)!0.40!(frame.north east)$);
      \fill[hcSurface] ($([yshift=-3.6pt]frame.north west)!0.40!([yshift=-3.6pt]frame.north east)$)
        rectangle ($(frame.north west)!0.60!(frame.north east)$);
      \fill[hcAccent] ($([yshift=-3.6pt]frame.north west)!0.60!([yshift=-3.6pt]frame.north east)$)
        rectangle ($(frame.north west)!0.80!(frame.north east)$);
      \fill[hcPrimary] ($([yshift=-3.6pt]frame.north west)!0.80!([yshift=-3.6pt]frame.north east)$)
        rectangle (frame.north east);
    \end{scope}
  \fi\fi
}

\newcommand{\hc@render@logoslot}{%
  \ifhc@has@projectlogo
    \hc@projectlogo
    \ifhc@has@orglogo
      \hspace{0.55em}\textcolor{hcLine}{\rule[-0.22em]{0.55pt}{1.35em}}\hspace{0.55em}%
      \hc@orglogo
    \fi
  \else
    \ifhc@has@orglogo
      \hc@orglogo
    \else
      \ifx\hc@reportdate\@empty\else
        {\sffamily\fontsize{8}{9.5}\selectfont\color{hcMuted}\hc@reportdate}%
      \fi
      \ifhc@showbrandmark
        \hspace{0.55em}\hc@brandmark
      \fi
    \fi
  \fi
}

%% Helper: render Header Title & Subtitle per language mode and theme voice
\newcommand{\hc@render@titles}{%
  \ifhc@lang@zh
    %% Pure Chinese: prefer \titlezh if set, otherwise fall back to \title
    \ifx\hc@titlezh\@empty
      {\hc@hero@align\hc@title@font@zh\@title\par}%
    \else
      {\hc@hero@align\hc@title@font@zh\hc@titlezh\par}%
    \fi
    \ifx\hc@subtitlezh\@empty
      \ifhc@acmart
        \ifx\@subtitle\@empty\else
          \vskip 3pt
          {\hc@hero@align\sffamily\fontsize{10.0}{13.6}\selectfont\color{hcMuted}\@subtitle\par}%
        \fi
      \fi
      \ifx\hc@subtitle\@empty\else
        \vskip 3pt
        {\hc@hero@align\sffamily\fontsize{10.0}{13.6}\selectfont\color{hcMuted}\hc@subtitle\par}%
      \fi
    \else
      \vskip 3pt
      {\hc@hero@align\sffamily\fontsize{10.0}{13.6}\selectfont\color{hcMuted}\hc@subtitlezh\par}%
    \fi
  \else\ifhc@lang@bi
    %% Bilingual: paired ZH + EN titles with clear typographic hierarchy
    \ifhc@bi@enzh
      {\hc@hero@align\hc@title@font@bi@a\@title\par}%
      \ifx\hc@titlezh\@empty\else
        \vskip 3pt
        {\hc@hero@align\hc@title@font@bi@b\hc@titlezh\par}%
      \fi
      \ifhc@acmart
        \ifx\@subtitle\@empty\else
          \vskip 2.4pt
          {\hc@hero@align\sffamily\fontsize{8.9}{11.6}\selectfont\color{hcMuted}\@subtitle\par}%
        \fi
      \fi
      \ifx\hc@subtitle\@empty\else
        \vskip 2.4pt
        {\hc@hero@align\sffamily\fontsize{8.9}{11.6}\selectfont\color{hcMuted}\hc@subtitle\par}%
      \fi
      \ifx\hc@subtitlezh\@empty\else
        \vskip 1.8pt
        {\hc@hero@align\sffamily\fontsize{8.6}{11.8}\selectfont\color{hcMuted}\hc@subtitlezh\par}%
      \fi
    \else
      \ifx\hc@titlezh\@empty
        {\hc@hero@align\hc@title@font@bi@a\@title\par}%
      \else
        {\hc@hero@align\hc@title@font@bi@a\hc@titlezh\par}%
        \vskip 2.8pt
        {\hc@hero@align\hc@title@font@bi@b\@title\par}%
      \fi
      \ifx\hc@subtitlezh\@empty\else
        \vskip 2.4pt
        {\hc@hero@align\sffamily\fontsize{8.8}{12.0}\selectfont\color{hcMuted}\hc@subtitlezh\par}%
      \fi
      \ifhc@acmart
        \ifx\@subtitle\@empty\else
          \vskip 1.6pt
          {\hc@hero@align\sffamily\fontsize{8.5}{11.2}\selectfont\color{hcMuted}\@subtitle\par}%
        \fi
      \fi
      \ifx\hc@subtitle\@empty\else
        \vskip 1.6pt
        {\hc@hero@align\sffamily\fontsize{8.5}{11.2}\selectfont\color{hcMuted}\hc@subtitle\par}%
      \fi
    \fi
  \else
    %% Pure English
    {\hc@hero@align\hc@title@font@en\@title\par}%
    \ifhc@acmart
      \ifx\@subtitle\@empty\else
        \vskip 3pt
        {\hc@hero@align\sffamily\fontsize{10.4}{13.2}\selectfont\color{hcMuted}\@subtitle\par}%
      \fi
    \fi
    \ifx\hc@subtitle\@empty\else
      \vskip 3pt
      {\hc@hero@align\sffamily\fontsize{10.4}{13.2}\selectfont\color{hcMuted}\hc@subtitle\par}%
    \fi
  \fi\fi
}

%% Helper: render Abstract + Keywords panel per language mode and theme
\newcommand{\hc@abs@eyebrow}[2][en]{%
  \ifhc@theme@claude
    \IfStrEq{#1}{zh}{%
      {\sffamily\bfseries\fontsize{8.4}{10.2}\selectfont\color{hcPrimaryDeep}#2\par}%
    }{%
      {\ttfamily\bfseries\fontsize{7.7}{9.4}\selectfont\color{hcPrimaryDeep}\hc@maybecaps{#2}\par}%
    }%
  \else\ifhc@theme@apple
    {\sffamily\bfseries\fontsize{8.8}{10.4}\selectfont\color{hcInk}#2\par}%
  \else
    {\sffamily\bfseries\fontsize{7.5}{9}\selectfont\color{hcPrimaryDark}%
      \tikz[baseline=-0.3ex]{\fill[hcPrimary] (0,0) circle (2.0pt); \fill[hcAccent] (5.2pt,0) circle (2.0pt);}%
      \hspace{0.46em}#2\par}%
  \fi\fi
}

\newcommand{\hc@kw@label}[4][en]{%
  \ifhc@theme@claude
    \IfStrEq{#1}{zh}{%
      {\sffamily\bfseries\fontsize{#2}{#3}\selectfont\color{hcMuted}#4}%
    }{%
      {\ttfamily\bfseries\fontsize{#2}{#3}\selectfont\color{hcMuted}\hc@maybecaps{#4}}%
    }%
  \else
    {\sffamily\bfseries\fontsize{#2}{#3}\selectfont\color{hcMuted}#4}%
  \fi
}

\newif\ifhc@show@abscard \hc@show@abscardfalse

\newcommand{\hc@render@abstractcard}{%
  \hc@show@abscardfalse
  \ifhc@lang@en
    \ifx\@abstract\@empty\else\hc@show@abscardtrue\fi
  \else
    \ifx\@abstract\@empty\else\hc@show@abscardtrue\fi
    \ifx\hc@abstractzh\@empty\else\hc@show@abscardtrue\fi
  \fi
  \ifhc@show@abscard
    \vskip 8pt
    \begin{tcolorbox}[
      enhanced,
      hc@abstractbox@skin
    ]
      \ifhc@lang@zh
        %% Pure Chinese abstract
        \hc@abs@eyebrow[zh]{\hc@lbl@abstractzh}%
        \vskip 3.8pt
        \ifx\hc@abstractzh\@empty
          {\fontsize{8.75}{12.4}\selectfont\color{hcInk}\@abstract\par}%
        \else
          {\fontsize{8.75}{12.4}\selectfont\color{hcInk}\hc@abstractzh\par}%
        \fi
        \ifx\hc@keywordszh\@empty
          \ifx\hc@keywords\@empty\else
            \vskip 5.8pt
            {\color{hcLine}\hrule height 0.45pt}%
            \vskip 4.8pt
            {\raggedright\linespread{1.32}\selectfont
              \hc@kw@label[en]{7.3}{8.6}{\hc@lbl@keywordszh}\hspace{0.55em}%
              \hc@renderkeywords{\hc@keywords}\par}%
          \fi
        \else
          \vskip 5.8pt
          {\color{hcLine}\hrule height 0.45pt}%
          \vskip 4.8pt
          {\raggedright\linespread{1.32}\selectfont
            \hc@kw@label[zh]{7.3}{8.6}{\hc@lbl@keywordszh}\hspace{0.55em}%
            \hc@renderkeywords{\hc@keywordszh}\par}%
        \fi
      \else\ifhc@lang@bi
        %% Bilingual abstract card (compact dual-language layout for balanced Page 1)
        \ifhc@bi@enzh
          \ifx\@abstract\@empty\else
            \hc@abs@eyebrow[en]{\hc@lbl@abstract}%
            \vskip 2.4pt
            {\fontsize{7.85}{10.1}\selectfont\color{hcInk}\@abstract\par}%
          \fi
          \ifx\hc@abstractzh\@empty\else
            \ifx\@abstract\@empty\else
              \vskip 4.0pt
              {\color{hcLine!75!hcSurface}\hrule height 0.4pt}%
              \vskip 3.8pt
            \fi
            \hc@abs@eyebrow[zh]{\hc@lbl@abstractzh}%
            \vskip 2.4pt
            {\fontsize{7.95}{10.9}\selectfont\color{hcInk}\hc@abstractzh\par}%
          \fi
        \else
          \ifx\hc@abstractzh\@empty\else
            \hc@abs@eyebrow[zh]{\hc@lbl@abstractzh}%
            \vskip 2.4pt
            {\fontsize{7.95}{10.9}\selectfont\color{hcInk}\hc@abstractzh\par}%
          \fi
          \ifx\@abstract\@empty\else
            \ifx\hc@abstractzh\@empty\else
              \vskip 4.0pt
              {\color{hcLine!75!hcSurface}\hrule height 0.4pt}%
              \vskip 3.8pt
            \fi
            \hc@abs@eyebrow[en]{\hc@lbl@abstract}%
            \vskip 2.4pt
            {\fontsize{7.85}{10.1}\selectfont\color{hcInk!88!hcMuted}\@abstract\par}%
          \fi
        \fi
        %% Bilingual keyword rows
        \ifboolexpr{ not test {\ifdefempty{\hc@keywordszh}} or not test {\ifdefempty{\hc@keywords}} }{%
          \vskip 4.5pt
          {\color{hcLine}\hrule height 0.45pt}%
          \vskip 4.0pt
          \ifhc@bi@enzh
            \ifx\hc@keywords\@empty\else
              {\raggedright\linespread{1.24}\selectfont
                \hc@kw@label[en]{7.0}{8.2}{\hc@lbl@keywords}\hspace{0.5em}%
                \hc@renderkeywords{\hc@keywords}\par}%
            \fi
            \ifx\hc@keywordszh\@empty\else
              \ifx\hc@keywords\@empty\else\vskip 2.2pt\fi
              {\raggedright\linespread{1.24}\selectfont
                \hc@kw@label[zh]{7.0}{8.2}{\hc@lbl@keywordszh}\hspace{0.5em}%
                \hc@renderkeywords{\hc@keywordszh}\par}%
            \fi
          \else
            \ifx\hc@keywordszh\@empty\else
              {\raggedright\linespread{1.24}\selectfont
                \hc@kw@label[zh]{7.0}{8.2}{\hc@lbl@keywordszh}\hspace{0.5em}%
                \hc@renderkeywords{\hc@keywordszh}\par}%
            \fi
            \ifx\hc@keywords\@empty\else
              \ifx\hc@keywordszh\@empty\else\vskip 2.2pt\fi
              {\raggedright\linespread{1.24}\selectfont
                \hc@kw@label[en]{7.0}{8.2}{\hc@lbl@keywords}\hspace{0.5em}%
                \hc@renderkeywords{\hc@keywords}\par}%
            \fi
          \fi
        }{}%
      \else
        %% Pure English abstract (100% v1.1 identical)
        \hc@abs@eyebrow[en]{\hc@lbl@abstract}%
        \vskip 4pt
        {\fontsize{8.75}{11.8}\selectfont\color{hcInk}\@abstract\par}%
        \ifx\hc@keywords\@empty\else
          \vskip 6.2pt
          {\color{hcLine}\hrule height 0.45pt}%
          \vskip 5.2pt
          {\raggedright\linespread{1.32}\selectfont
            \hc@kw@label[en]{7.3}{8.5}{\hc@lbl@keywords}\hspace{0.55em}%
            \hc@renderkeywords{\hc@keywords}\par}%
        \fi
      \fi\fi
    \end{tcolorbox}%
  \fi
}

\newcommand{\hc@render@eyebrow}{%
  \ifhc@theme@claude
    \ifx\hc@reportlabel\@empty\else
      \ifhc@lang@en
        {\ttfamily\bfseries\fontsize{7.5}{9.0}\selectfont\color{hcPrimaryDeep}\hc@maybecaps{\hc@reportlabel}}%
      \else
        {\sffamily\bfseries\fontsize{7.7}{9.2}\selectfont\color{hcPrimaryDeep}\hc@reportlabel}%
      \fi
    \fi
    \ifx\hc@reportbadge\@empty\else
      \ifx\hc@reportlabel\@empty\else\hspace{0.5em}\fi
      \tcbox[
        on line, enhanced,
        colback=hcBadgePillBg, colframe=hcBadgePillBorder,
        boxrule=0.35pt, arc=5pt,
        boxsep=0pt, left=5.5pt, right=5.5pt, top=2.0pt, bottom=2.0pt,
        nobeforeafter, tcbox raise base
      ]{\sffamily\bfseries\fontsize{7.0}{8.2}\selectfont\color{hcBadgePillInk}\hc@reportbadge}%
    \fi
  \else\ifhc@theme@apple
    \ifx\hc@reportlabel\@empty\else
      {\sffamily\bfseries\fontsize{8.0}{9.4}\selectfont\color{hcInk}\hc@reportlabel}%
    \fi
    \ifx\hc@reportbadge\@empty\else
      \ifx\hc@reportlabel\@empty\else\hspace{0.5em}\textcolor{hcMuted}{\textperiodcentered}\hspace{0.5em}\fi
      {\sffamily\fontsize{7.8}{9.2}\selectfont\color{hcMuted}\hc@reportbadge}%
    \fi
  \else
    \ifx\hc@reportlabel\@empty\else
      \tcbox[
        on line, enhanced,
        colback=hcReportPillBg, colframe=hcReportPillBorder,
        boxrule=0.45pt, arc=4.5pt,
        boxsep=0pt, left=6.5pt, right=6.5pt, top=2.4pt, bottom=2.4pt,
        nobeforeafter, tcbox raise base
      ]{\sffamily\bfseries\fontsize{7.3}{8.5}\selectfont\color{hcReportPillInk}\hc@maybecaps{\hc@reportlabel}}%
    \fi
    \ifx\hc@reportbadge\@empty\else
      \hspace{0.45em}%
      \tcbox[
        on line, enhanced,
        colback=hcBadgePillBg, colframe=hcBadgePillBorder,
        boxrule=0.45pt, arc=4.5pt,
        boxsep=0pt, left=6pt, right=6pt, top=2.4pt, bottom=2.4pt,
        nobeforeafter, tcbox raise base
      ]{\sffamily\bfseries\fontsize{7.3}{8.5}\selectfont\color{hcBadgePillInk}\hc@reportbadge}%
    \fi
  \fi\fi
  \ifboolexpr{ bool {hc@has@projectlogo} or bool {hc@has@orglogo} }{%
    \ifx\hc@reportdate\@empty\else
      \hspace{0.55em}\textcolor{hcLine}{\rule[-0.15em]{0.45pt}{0.85em}}\hspace{0.55em}%
      {\sffamily\fontsize{7.7}{9}\selectfont\color{hcMuted}\hc@reportdate}%
    \fi
  }{}%
}

\newcommand{\hc@buildheadercard}{%
  \begingroup
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{0pt}%
  \begin{tcolorbox}[
    enhanced,
    hc@headerbox@skin
  ]
    %% --- Top Eyebrow Row: Category Labels / Pills (+ Date) | Dual Logo Slot ---
    \noindent
    \begin{minipage}[c]{0.64\linewidth}
      \raggedright
      \hc@render@eyebrow
    \end{minipage}%
    \hfill
    \begin{minipage}[c]{0.34\linewidth}
      \raggedleft
      \hc@render@logoslot
    \end{minipage}

    \ifhc@theme@apple
      \vskip 5pt
      {\color{hcNavRule}\hrule height 0.45pt}%
      \vskip 8.5pt
    \else
      \vskip 7pt
    \fi

    %% --- Paper Title & Optional Subtitle (Language-Aware) ---
    \hc@render@titles

    %% --- Authors with Clickable Vector ORCID Icons ---
    \ifnum\hc@authorcount>0\relax
      \vskip 6.8pt
      {\hc@hero@align\fontsize{9.6}{13.4}\selectfont\hc@authors@render\par}%
    \fi

    %% --- Affiliations ---
    \ifnum\hc@affilcount>0\relax
      \vskip 3.6pt
      {\hc@hero@align\fontsize{8.3}{11.4}\selectfont\hc@affiliations\par}%
    \fi

    %% --- Author Notes & Correspondence ---
    \ifnum\hc@notecount>0\relax
      \vskip 2.8pt
      {\hc@hero@align\fontsize{7.8}{10.6}\selectfont\hc@authornotes
        \ifx\hc@correspondence\@empty\else
          \hspace{0.85em}\textcolor{hcPrimaryBorder}{\textperiodcentered}\hspace{0.85em}%
          \textcolor{hcPrimaryDeep}{\faEnvelope[regular]}\hspace{0.32em}%
          {\sffamily\color{hcUrlColor}\hc@in@corresptrue\hc@correspondence\hc@in@correspfalse}%
        \fi
      \par}%
    \else
      \ifx\hc@correspondence\@empty\else
        \vskip 2.8pt
        {\hc@hero@align\fontsize{7.8}{10.6}\selectfont
          \textcolor{hcPrimaryDeep}{\faEnvelope[regular]}\hspace{0.35em}%
          {\sffamily\color{hcUrlColor}\hc@in@corresptrue\hc@correspondence\hc@in@correspfalse}\par}%
      \fi
    \fi

    %% --- Resource Metadata Pill Bar ---
    \ifnum\hc@metacount>0\relax
      \vskip 7.2pt
      {\hc@hero@align\linespread{\ifhc@layout@healthcard 1.34\else 1.44\fi}\selectfont\hc@metadata\par}%
    \fi

    %% --- Nested Pure-White Abstract Health Card ---
    \hc@render@abstractcard
  \end{tcolorbox}%
  \endgroup
}

%% Resolve effective running headers & PDF metadata cleanly across modes
\newcommand{\hc@resolve@running}{%
  %% Effective short title
  \ifhc@lang@zh
    \ifx\hc@shorttitlezh\@empty
      \ifx\hc@shorttitle\@empty
        \ifx\hc@titlezh\@empty
          \gdef\hc@effective@title{\@title}%
        \else
          \gdef\hc@effective@title{\hc@titlezh}%
        \fi
      \else
        \gdef\hc@effective@title{\hc@shorttitle}%
      \fi
    \else
      \gdef\hc@effective@title{\hc@shorttitlezh}%
    \fi
  \else
    \ifx\hc@shorttitle\@empty
      \ifhc@acmart
        \ifx\shorttitle\@empty
          \gdef\hc@effective@title{\@title}%
        \else
          \gdef\hc@effective@title{\shorttitle}%
        \fi
      \else
        \gdef\hc@effective@title{\@title}%
      \fi
    \else
      \gdef\hc@effective@title{\hc@shorttitle}%
    \fi
  \fi
  %% Effective short authors
  \ifhc@lang@zh
    \ifx\hc@shortauthorszh\@empty
      \ifx\hc@shortauthors\@empty
        \gdef\hc@effective@authors{\hc@authors@plain}%
      \else
        \gdef\hc@effective@authors{\hc@shortauthors}%
      \fi
    \else
      \gdef\hc@effective@authors{\hc@shortauthorszh}%
    \fi
  \else
    \ifx\hc@shortauthors\@empty
      \ifhc@acmart
        \ifx\shortauthors\@empty
          \gdef\hc@effective@authors{\hc@authors@plain}%
        \else
          \gdef\hc@effective@authors{\shortauthors}%
        \fi
      \else
        \gdef\hc@effective@authors{\hc@authors@plain}%
      \fi
    \else
      \gdef\hc@effective@authors{\hc@shortauthors}%
    \fi
  \fi
  %% Resolve PDF title
  \ifx\hc@pdftitle\@empty
    \ifhc@lang@zh
      \ifx\hc@titlezh\@empty
        \gdef\hc@effective@pdftitle{\@title}%
      \else
        \gdef\hc@effective@pdftitle{\hc@titlezh}%
      \fi
    \else\ifhc@lang@bi
      \ifx\hc@titlezh\@empty
        \gdef\hc@effective@pdftitle{\@title}%
      \else
        \ifhc@bi@enzh
          \gdef\hc@effective@pdftitle{\@title\ (\hc@titlezh)}%
        \else
          \gdef\hc@effective@pdftitle{\hc@titlezh\ (\@title)}%
        \fi
      \fi
    \else
      \gdef\hc@effective@pdftitle{\@title}%
    \fi\fi
  \else
    \gdef\hc@effective@pdftitle{\hc@pdftitle}%
  \fi
  %% Resolve PDF subtitle (for XMP prism:subtitle)
  \ifx\hc@subtitle\@empty
    \ifhc@acmart\let\hc@raw@ensub\@subtitle\else\def\hc@raw@ensub{}\fi
  \else
    \let\hc@raw@ensub\hc@subtitle
  \fi
  \ifhc@lang@zh
    \ifx\hc@subtitlezh\@empty
      \global\let\hc@effective@pdfsubtitle\hc@raw@ensub
    \else
      \global\let\hc@effective@pdfsubtitle\hc@subtitlezh
    \fi
  \else\ifhc@lang@bi
    \ifx\hc@subtitlezh\@empty
      \global\let\hc@effective@pdfsubtitle\hc@raw@ensub
    \else\ifx\hc@raw@ensub\@empty
      \global\let\hc@effective@pdfsubtitle\hc@subtitlezh
    \else
      \ifhc@bi@enzh
        \gdef\hc@effective@pdfsubtitle{\hc@raw@ensub\ (\hc@subtitlezh)}%
      \else
        \gdef\hc@effective@pdfsubtitle{\hc@subtitlezh\ (\hc@raw@ensub)}%
      \fi
    \fi\fi
  \else
    \global\let\hc@effective@pdfsubtitle\hc@raw@ensub
  \fi\fi
  %% Resolve PDF author
  \ifx\hc@pdfauthor\@empty
    \gdef\hc@effective@pdfauthor{\hc@authors@plain}%
  \else
    \gdef\hc@effective@pdfauthor{\hc@pdfauthor}%
  \fi
  %% Resolve PDF keywords
  \ifx\hc@pdfkeywords\@empty
    \ifhc@lang@en
      \gdef\hc@effective@pdfkeywords{\hc@keywords}%
    \else\ifhc@lang@zh
      \ifx\hc@keywordszh\@empty
        \gdef\hc@effective@pdfkeywords{\hc@keywords}%
      \else
        \gdef\hc@effective@pdfkeywords{\hc@keywordszh}%
      \fi
    \else
      \ifx\hc@keywordszh\@empty
        \gdef\hc@effective@pdfkeywords{\hc@keywords}%
      \else
        \ifx\hc@keywords\@empty
          \gdef\hc@effective@pdfkeywords{\hc@keywordszh}%
        \else
          \ifhc@bi@enzh
            \gdef\hc@effective@pdfkeywords{\hc@keywords, \hc@keywordszh}%
          \else
            \gdef\hc@effective@pdfkeywords{\hc@keywordszh, \hc@keywords}%
          \fi
        \fi
      \fi
    \fi\fi
  \else
    \gdef\hc@effective@pdfkeywords{\hc@pdfkeywords}%
  \fi
  %% Resolve PDF language (explicit pdflang or derived from lang/biorder)
  \ifx\hc@pdflang\@empty
    \ifhc@lang@zh
      \gdef\hc@effective@pdflang{zh-CN}%
    \else\ifhc@lang@bi
      \ifhc@bi@enzh
        \gdef\hc@effective@pdflang{en}%
      \else
        \gdef\hc@effective@pdflang{zh-CN}%
      \fi
    \else
      \gdef\hc@effective@pdflang{en}%
    \fi\fi
  \else
    \gdef\hc@effective@pdflang{\hc@pdflang}%
  \fi
  %% Resolve PDF publisher (explicit publisher, else venue)
  \ifx\hc@publisher\@empty
    \global\let\hc@effective@pdfpublisher\hc@venue
  \else
    \gdef\hc@effective@pdfpublisher{\hc@publisher}%
  \fi
  %% Resolve PDF subject (explicit \hcsubject, or auto-composed from venue/doi/arxiv/license)
  \ifx\hc@subject\@empty
    \def\hc@effective@pdfsubject{}%
    \ifx\hc@venue\@empty\else\appto\hc@effective@pdfsubject{\hc@venue}\fi
    \ifx\hc@version\@empty\else
      \ifx\hc@effective@pdfsubject\@empty\else\appto\hc@effective@pdfsubject{ | }\fi
      \appto\hc@effective@pdfsubject{\hc@version}%
    \fi
    \ifx\hc@arxiv\@empty\else
      \ifx\hc@effective@pdfsubject\@empty\else\appto\hc@effective@pdfsubject{ | }\fi
      \appto\hc@effective@pdfsubject{arXiv: \hc@arxiv}%
    \fi
    \ifx\hc@doi\@empty\else
      \ifx\hc@effective@pdfsubject\@empty\else\appto\hc@effective@pdfsubject{ | }\fi
      \appto\hc@effective@pdfsubject{DOI: \hc@doi}%
    \fi
    \ifx\hc@license\@empty\else
      \ifx\hc@effective@pdfsubject\@empty\else\appto\hc@effective@pdfsubject{ | }\fi
      \appto\hc@effective@pdfsubject{License: \hc@license}%
    \fi
  \else
    \gdef\hc@effective@pdfsubject{\hc@subject}%
  \fi
}

\newif\ifhc@twocol \hc@twocolfalse
\newif\ifhc@before@begindoc \hc@before@begindoctrue
\AtBeginDocument{\hc@before@begindocfalse}

\newcommand{\hc@hypersetup@ifnonempty}[2]{%
  \ifx#2\@empty\else\hypersetup{#1={#2}}\fi
}

\newcommand{\hc@sync@pdfmetadata}{%
  \hc@resolve@running
  \hypersetup{%
    pdftitle={\hc@effective@pdftitle},
    pdfauthor={\hc@effective@pdfauthor},
    pdfsubject={\hc@effective@pdfsubject},
    pdfkeywords={\hc@effective@pdfkeywords},
    pdfcreator={\hc@creator}%
  }%
  %% Set pdflang only before \Hy@DisableOption{pdflang} fires at \AtBeginDocument;
  %% leave pdfmetalang empty so hyperxmp copies clean ASCII \@pdflang.
  \ifhc@before@begindoc
    \hypersetup{pdflang={\hc@effective@pdflang}}%
  \fi
  \@ifpackageloaded{hyperxmp}{%
    %% Prevent acmart/hyperxmp from defaulting independent reports to ACM / book
    \gdef\hyxmp@acm@publisher{}%
    \hc@hypersetup@ifnonempty{pdfpubtype}{\hc@pubtype}%
    \hc@hypersetup@ifnonempty{pdfsubtitle}{\hc@effective@pdfsubtitle}%
    \hc@hypersetup@ifnonempty{pdfpublisher}{\hc@effective@pdfpublisher}%
    \hc@hypersetup@ifnonempty{pdfpublication}{\hc@venue}%
    \hc@hypersetup@ifnonempty{pdfcopyright}{\hc@license}%
    \hc@hypersetup@ifnonempty{pdflicenseurl}{\hc@licenseurl}%
    \hc@hypersetup@ifnonempty{pdfdoi}{\hc@doi}%
    \hc@hypersetup@ifnonempty{pdfurl}{\hc@url}%
    \hc@hypersetup@ifnonempty{pdfcontactemail}{\hc@contactemail}%
  }{}%
}

\AddToHook{begindocument/before}{%
  \ifhc@cjk\ifPDFTeX\else
    \hc@sync@pdfmetadata
  \fi\else
    \hc@sync@pdfmetadata
  \fi
}

\renewcommand{\maketitle}{%
  \ifhc@acmart
    \@ACM@maketitle@typesettrue
  \fi
  \hc@resolve@running
  \ifhc@cjk\ifPDFTeX\else
    \hc@sync@pdfmetadata
  \fi\else
    \hc@sync@pdfmetadata
  \fi
  \global\setbox\hc@titlebox=\vbox{%
    \hsize=\textwidth
    \ifhc@acmart
      \let\@vspace\@vspace@orig
      \let\@vspacer\@vspacer@orig
      \ifnum\ACM@format@nr=0\relax
        \vspace*{-16pt}%
      \else\ifnum\ACM@format@nr=5\relax
        \vspace*{-16pt}%
      \else
        \vspace*{-\dimexpr\headheight+\headsep-4pt\relax}%
      \fi\fi
    \fi
    \hc@buildheadercard
    \vskip 9pt
  }%
  \hc@twocolfalse
  \if@twocolumn\hc@twocoltrue\fi
  \ifhc@acmart
    \ifcase\ACM@format@nr
    \or\or\or \hc@twocoltrue \or \hc@twocoltrue \or \hc@twocoltrue
    \or \hc@twocoltrue \or \hc@twocoltrue \or \or \hc@twocoltrue \or
    \fi
  \fi
  \ifhc@twocol
    \twocolumn[\noindent\box\hc@titlebox]%
  \else
    \noindent\box\hc@titlebox\par
  \fi
  \thispagestyle{firstpagestyle}%
  \global\@topnum\z@
  \@afterindentfalse
  \@afterheading
}

