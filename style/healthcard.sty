%% Inline bilingual term: \hcbi{中文}{English} (bookmark & PDF-metadata safe)
\DeclareRobustCommand{\hcbi}[2]{%
  \ifhc@lang@en #2%
  \else\ifhc@lang@zh #1%
  \else
    \ifhc@bi@enzh #2\texorpdfstring{\hspace{0.26em}{\color{hcMuted}(#1)}}{ (#1)}%
    \else #1\texorpdfstring{\hspace{0.26em}{\color{hcMuted}(#2)}}{ (#2)}\fi
  \fi\fi
}

%% Separator bilingual label: \hcbisep{中文}{English} (bookmark & PDF-metadata safe)
\DeclareRobustCommand{\hcbisep}[2]{%
  \ifhc@lang@en #2%
  \else\ifhc@lang@zh #1%
  \else
    \ifhc@bi@enzh #2\texorpdfstring{\;\textperiodcentered\;}{ / }#1%
    \else #1\texorpdfstring{\;\textperiodcentered\;}{ / }#2\fi
  \fi\fi
}

%% Bilingual headings (bookmark-safe via \texorpdfstring)
\newcommand{\hcsecbi}[2]{%
  \ifhc@lang@en
    \section{#2}%
  \else\ifhc@lang@zh
    \section{#1}%
  \else
    \ifhc@bi@enzh
      \section[\texorpdfstring{#2 (#1)}{#2 (#1)}]{#2\texorpdfstring{\hspace{0.42em}{\normalfont\sffamily\fontsize{8.8}{11.2}\selectfont\color{hcPrimaryDeep}#1}}{ (#1)}}%
    \else
      \section[\texorpdfstring{#1 (#2)}{#1 (#2)}]{#1\texorpdfstring{\hspace{0.42em}{\normalfont\sffamily\fontsize{8.6}{11.0}\selectfont\color{hcPrimaryDeep}#2}}{ (#2)}}%
    \fi
  \fi\fi
}

\newcommand{\hcsecbistar}[2]{%
  \ifhc@lang@en
    \section*{#2}%
  \else\ifhc@lang@zh
    \section*{#1}%
  \else
    \ifhc@bi@enzh
      \section*{#2\texorpdfstring{\hspace{0.42em}{\normalfont\sffamily\fontsize{8.8}{11.2}\selectfont\color{hcPrimaryDeep}#1}}{ (#1)}}%
    \else
      \section*{#1\texorpdfstring{\hspace{0.42em}{\normalfont\sffamily\fontsize{8.6}{11.0}\selectfont\color{hcPrimaryDeep}#2}}{ (#2)}}%
    \fi
  \fi\fi
}

\newcommand{\hcsubsecbi}[2]{%
  \Needspace{3.8\baselineskip}%
  \ifhc@lang@en
    \subsection{#2}%
  \else\ifhc@lang@zh
    \subsection{#1}%
  \else
    \ifhc@bi@enzh
      \subsection[\texorpdfstring{#2 (#1)}{#2 (#1)}]{#2\texorpdfstring{\hspace{0.38em}{\normalfont\sffamily\fontsize{8.3}{10.5}\selectfont\color{hcMuted}#1}}{ (#1)}}%
    \else
      \subsection[\texorpdfstring{#1 (#2)}{#1 (#2)}]{#1\texorpdfstring{\hspace{0.38em}{\normalfont\sffamily\fontsize{8.2}{10.4}\selectfont\color{hcMuted}#2}}{ (#2)}}%
    \fi
  \fi\fi
}

\newcommand{\hcparbi}[2]{%
  \ifhc@lang@en
    \paragraph{#2}%
  \else\ifhc@lang@zh
    \paragraph{#1}%
  \else
    \ifhc@bi@enzh
      \paragraph{#2\texorpdfstring{\,{\normalfont\sffamily\fontsize{7.8}{10}\selectfont\color{hcMuted}(#1)}}{ (#1)}}%
    \else
      \paragraph{#1\texorpdfstring{\,{\normalfont\sffamily\fontsize{7.8}{10}\selectfont\color{hcMuted}(#2)}}{ (#2)}}%
    \fi
  \fi\fi
}

%% Paired bilingual paragraph block: \hcbipair{中文段落}{English paragraph}
%% Renders cleanly as a single-language paragraph in en/zh modes, and as a
%% visually distinct paired block in bilingual mode for effortless scanning.
\newcommand{\hcbipair}[2]{%
  \ifhc@lang@en
    #2\par
  \else\ifhc@lang@zh
    #1\par
  \else
    \ifhc@bi@enzh
      \noindent{\color{hcInk}#2\par}%
      \vskip 2.2pt%
      \noindent{\fontsize{8.45}{11.8}\selectfont\color{hcInk!84!hcMuted}#1\par}%
      \vskip 4.8pt%
    \else
      \noindent{\fontsize{8.8}{12.5}\selectfont\color{hcInk}#1\par}%
      \vskip 2.2pt%
      \noindent{\fontsize{8.35}{10.9}\selectfont\color{hcInk!84!hcMuted}#2\par}%
      \vskip 4.8pt%
    \fi
  \fi\fi
}

%% Bilingual figure / table caption helper: \hcbicaption{中文图注}{English caption}
\newcommand{\hcbicaption}[2]{%
  \ifhc@lang@en
    \caption{#2}%
  \else\ifhc@lang@zh
    \caption{#1}%
  \else
    \ifhc@bi@enzh
      \caption[#2]{#2\protect\\[1.5pt]{\fontsize{7.4}{9.8}\selectfont\color{hcMuted!90!hcInk}#1}}%
    \else
      \caption[#1]{#1\protect\\[1.5pt]{\fontsize{7.4}{9.6}\selectfont\color{hcMuted!90!hcInk}#2}}%
    \fi
  \fi\fi
}

