\newbox\hc@titlebox

\newcommand{\hc@drawribbon}{%
  \ifhc@ribbon@gradient
    \begin{scope}
      \clip[rounded corners=9pt] (frame.south west) rectangle (frame.north east);
      \shade[shading=hcRibbonGrad]
        ([yshift=-3.6pt]frame.north west) rectangle (frame.north east);
    \end{scope}
  \else\ifhc@ribbon@stripe
    \begin{scope}
      \clip[rounded corners=9pt] (frame.south west) rectangle (frame.north east);
      \fill[hcPrimary] ([yshift=-3.6pt]frame.north west)
        rectangle ($(frame.north west)!0.20!(frame.north east)$);
      \fill[hcAccent] ($([yshift=-3.6pt]frame.north west)!0.20!([yshift=-3.6pt]frame.north east)$)
        rectangle ($(frame.north west)!0.40!(frame.north east)$);
      \fill[hcSurface] ($([yshift=-3.6pt]frame.north west)!0.40!([yshift=-3.6pt]frame.north east)$)
        rectangle ($(frame.north west)!0.60!(frame.north east)$);
      \fill[hcAccent] ($([yshift=-3.6pt]frame.north west)!0.60!([yshift=-3.6pt]frame.north east)$)
        rectangle ($(frame.north west)!0.80!(frame.north east)$);
      \fill[hcPrimary] ($([yshift=-3.6pt]frame.north west)!0.80!([yshift=-3.6pt]frame.north east)$)
        rectangle (frame.north east);
    \end{scope}
  \fi\fi
}

%% Render right-hand dual logo slot cleanly (16pt-20pt optical alignment)
\newcommand{\hc@render@logoslot}{%
  \ifhc@has@projectlogo
    \hc@projectlogo
    \ifhc@has@orglogo
      \hspace{0.55em}\textcolor{hcLine}{\rule[-0.22em]{0.55pt}{1.35em}}\hspace{0.55em}%
      \hc@orglogo
    \fi
  \else
    \ifhc@has@orglogo
      \hc@orglogo
    \else
      \ifx\hc@reportdate\@empty\else
        {\sffamily\fontsize{8}{9.5}\selectfont\color{hcMuted}\hc@reportdate}%
      \fi
      \ifhc@showbrandmark
        \hspace{0.55em}\hc@brandmark
      \fi
    \fi
  \fi
}

\newcommand{\hc@buildheadercard}{%
  \begingroup
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{0pt}%
  \begin{tcolorbox}[
    enhanced,
    width=\textwidth,
    colback=\ifhc@header@clean hcSurface\else hcPrimaryBg!75!hcSurface\fi,
    colframe=hcPrimaryBorder,
    boxrule=0.75pt,
    arc=9pt,
    outer arc=9pt,
    left=14pt, right=14pt,
    top=\ifhc@ribbon@none 11.5pt\else 13.5pt\fi,
    bottom=11.5pt,
    boxsep=0pt,
    before skip=0pt,
    after skip=0pt,
    overlay={\hc@drawribbon}
  ]
    %% --- Top Eyebrow Row: Category Pills (+ Date when dual logos set) | Dual Logo Slot ---
    \noindent
    \begin{minipage}[c]{0.58\linewidth}
      \raggedright
      \ifx\hc@reportlabel\@empty\else
        \tcbox[
          on line, enhanced,
          colback=hcPrimarySoft, colframe=hcPrimaryBorder,
          boxrule=0.45pt, arc=4.5pt,
          boxsep=0pt, left=6.5pt, right=6.5pt, top=2.4pt, bottom=2.4pt,
          nobeforeafter, tcbox raise base
        ]{\sffamily\bfseries\fontsize{7.4}{8.5}\selectfont\color{hcPrimaryDark}\MakeUppercase{\hc@reportlabel}}%
      \fi
      \ifx\hc@reportbadge\@empty\else
        \hspace{0.45em}%
        \tcbox[
          on line, enhanced,
          colback=hcAccentSoft, colframe=hcAccentBorder,
          boxrule=0.45pt, arc=4.5pt,
          boxsep=0pt, left=6pt, right=6pt, top=2.4pt, bottom=2.4pt,
          nobeforeafter, tcbox raise base
        ]{\sffamily\bfseries\fontsize{7.3}{8.5}\selectfont\color{hcAccentDark}\hc@reportbadge}%
      \fi
      %% If custom project/org logos occupy the right slot, place date cleanly beside pills
      \ifboolexpr{ bool {hc@has@projectlogo} or bool {hc@has@orglogo} }{%
        \ifx\hc@reportdate\@empty\else
          \hspace{0.6em}\textcolor{hcPrimaryBorder}{\textperiodcentered}\hspace{0.55em}%
          {\sffamily\fontsize{7.8}{9}\selectfont\color{hcMuted}\hc@reportdate}%
        \fi
      }{}%
    \end{minipage}%
    \hfill
    \begin{minipage}[c]{0.40\linewidth}
      \raggedleft
      \hc@render@logoslot
    \end{minipage}

    \vskip 7.5pt

    %% --- Paper Title & Optional Subtitle ---
    {\raggedright\sffamily\bfseries\fontsize{16.5}{20.4}\selectfont\color{hcPrimaryDark}\@title\par}%
    \ifhc@acmart
      \ifx\@subtitle\@empty\else
        \vskip 3pt
        {\raggedright\sffamily\fontsize{10.4}{13.2}\selectfont\color{hcMuted}\@subtitle\par}%
      \fi
    \fi
    \ifx\hc@subtitle\@empty\else
      \vskip 3pt
      {\raggedright\sffamily\fontsize{10.4}{13.2}\selectfont\color{hcMuted}\hc@subtitle\par}%
    \fi

    %% --- Authors with Clickable Vector ORCID Icons ---
    \ifnum\hc@authorcount>0\relax
      \vskip 7.2pt
      {\raggedright\fontsize{9.6}{13.4}\selectfont\hc@authors@render\par}%
    \fi

    %% --- Affiliations ---
    \ifnum\hc@affilcount>0\relax
      \vskip 3.8pt
      {\raggedright\fontsize{8.3}{11.2}\selectfont\hc@affiliations\par}%
    \fi

    %% --- Author Notes & Correspondence ---
    \ifnum\hc@notecount>0\relax
      \vskip 2.8pt
      {\raggedright\fontsize{7.8}{10.4}\selectfont\hc@authornotes
        \ifx\hc@correspondence\@empty\else
          \hspace{0.85em}\textcolor{hcPrimaryBorder}{\textperiodcentered}\hspace{0.85em}%
          \textcolor{hcPrimaryDeep}{\faEnvelope[regular]}\hspace{0.32em}%
          {\sffamily\color{hcUrlColor}\hc@correspondence}%
        \fi
      \par}%
    \else
      \ifx\hc@correspondence\@empty\else
        \vskip 2.8pt
        {\raggedright\fontsize{7.8}{10.4}\selectfont
          \textcolor{hcPrimaryDeep}{\faEnvelope[regular]}\hspace{0.35em}%
          {\sffamily\color{hcUrlColor}\hc@correspondence}\par}%
      \fi
    \fi

    %% --- Resource Metadata Pill Bar ---
    \ifnum\hc@metacount>0\relax
      \vskip 7pt
      {\raggedright\linespread{1.35}\selectfont\hc@metadata\par}%
    \fi

    %% --- Nested Pure-White Abstract Health Card ---
    \ifx\@abstract\@empty\else
      \vskip 8.5pt
      \begin{tcolorbox}[
        enhanced,
        width=\linewidth,
        colback=\ifhc@header@clean hcCanvas\else hcSurface\fi,
        colframe=hcLine,
        boxrule=0.55pt,
        arc=6.5pt,
        outer arc=6.5pt,
        borderline west={2.8pt}{0pt}{hcAccent},
        left=10.5pt, right=10.5pt,
        top=7.2pt, bottom=7.2pt,
        boxsep=0pt,
        before skip=0pt,
        after skip=0pt
      ]
        {\sffamily\bfseries\fontsize{7.6}{9}\selectfont\color{hcPrimaryDark}%
          \tikz[baseline=-0.3ex]{\fill[hcPrimary] (0,0) circle (2.1pt); \fill[hcAccent] (5.4pt,0) circle (2.1pt);}%
          \hspace{0.48em}ABSTRACT\par}%
        \vskip 4pt
        {\fontsize{8.75}{11.8}\selectfont\color{hcInk}\@abstract\par}%
        \ifx\hc@keywords\@empty\else
          \vskip 6.2pt
          {\color{hcLine}\hrule height 0.45pt}%
          \vskip 5.2pt
          {\raggedright\linespread{1.32}\selectfont
            {\sffamily\bfseries\fontsize{7.3}{8.5}\selectfont\color{hcMuted}KEYWORDS\hspace{0.55em}}%
            \hc@renderkeywords{\hc@keywords}\par}%
        \fi
      \end{tcolorbox}%
    \fi
  \end{tcolorbox}%
  \endgroup
}

%% Resolve effective short title / short authors for running headers & PDF metadata
\newcommand{\hc@resolve@running}{%
  \ifx\hc@shorttitle\@empty
    \ifhc@acmart
      \ifx\shorttitle\@empty
        \gdef\hc@effective@title{\@title}%
      \else
        \gdef\hc@effective@title{\shorttitle}%
      \fi
    \else
      \gdef\hc@effective@title{\@title}%
    \fi
  \else
    \gdef\hc@effective@title{\hc@shorttitle}%
  \fi
  \ifx\hc@shortauthors\@empty
    \ifhc@acmart
      \ifx\shortauthors\@empty
        \gdef\hc@effective@authors{\hc@authors@plain}%
      \else
        \gdef\hc@effective@authors{\shortauthors}%
      \fi
    \else
      \gdef\hc@effective@authors{\hc@authors@plain}%
    \fi
  \else
    \gdef\hc@effective@authors{\hc@shortauthors}%
  \fi
}

\newif\ifhc@twocol \hc@twocolfalse

\renewcommand{\maketitle}{%
  \ifhc@acmart
    \@ACM@maketitle@typesettrue
  \fi
  \hc@resolve@running
  \hypersetup{%
    pdftitle={\@title},
    pdfauthor={\hc@authors@plain},
    pdfkeywords={\hc@keywords}
  }%
  \global\setbox\hc@titlebox=\vbox{%
    \hsize=\textwidth
    \hc@buildheadercard
    \vskip 10pt
  }%
  \hc@twocolfalse
  \if@twocolumn\hc@twocoltrue\fi
  \ifhc@acmart
    \ifcase\ACM@format@nr
    \or\or\or \hc@twocoltrue \or \hc@twocoltrue \or \hc@twocoltrue
    \or \hc@twocoltrue \or \hc@twocoltrue \or \or \hc@twocoltrue \or
    \fi
  \fi
  \ifhc@twocol
    \twocolumn[\noindent\box\hc@titlebox]%
  \else
    \noindent\box\hc@titlebox\par
  \fi
  \thispagestyle{firstpagestyle}%
  \global\@topnum\z@
  \@afterindentfalse
  \@afterheading
}

%% -----------------------------------------------------------------------------
%% 10. Section Headings (100% acmart-Safe — Zero Redefinition of \section!)
%% -----------------------------------------------------------------------------
\DeclareRobustCommand{\hc@secnumbadge}[1]{%
  \tcbox[
    on line, enhanced,
    colback=hcPrimarySoft,
    colframe=hcPrimaryBorder,
    boxrule=0.45pt,
    arc=3pt,
    boxsep=0pt,
    left=4pt, right=4pt, top=1.5pt, bottom=1.5pt,
    nobeforeafter, tcbox raise base
  ]{\sffamily\bfseries\fontsize{8.8}{10}\selectfont\color{hcPrimaryDark}#1}%
  \hspace{0.48em}%
}

\DeclareRobustCommand{\hc@subsecnum}[1]{%
  {\sffamily\bfseries\color{hcAccentDeep}#1}\hspace{0.48em}%
}

\DeclareRobustCommand{\hc@subsubsecnum}[1]{%
  {\sffamily\bfseries\color{hcPrimaryDeep}#1}\hspace{0.42em}%
}

\DeclareRobustCommand{\hc@formatseccnt}[2]{%
  \IfStrEq{#1}{section}{%
    \hc@secnumbadge{#2}%
  }{%
    \IfStrEq{#1}{subsection}{%
      \hc@subsecnum{#2}%
    }{%
      \hc@subsubsecnum{#2}%
    }%
  }%
}

\def\@seccntformat#1{\hc@formatseccnt{#1}{\csname the#1\endcsname}}

\ifhc@acmart
  \def\@secfont{\sffamily\bfseries\fontsize{11.2}{13.8}\selectfont\color{hcPrimaryDark}\section@raggedright}
  \def\@subsecfont{\sffamily\bfseries\fontsize{9.8}{12.2}\selectfont\color{hcInk}\section@raggedright}
  \def\@subsubsecfont{\sffamily\bfseries\fontsize{9}{11.2}\selectfont\color{hcPrimaryDeep}}
  \def\@parfont{\sffamily\bfseries\fontsize{9}{11.2}\selectfont\color{hcInk}}
\else
  \RequirePackage{titlesec}
  \titleformat{\section}{\sffamily\bfseries\fontsize{11.2}{13.8}\selectfont\color{hcPrimaryDark}}{\hc@secnumbadge{\thesection}}{0pt}{}
  \titleformat{\subsection}{\sffamily\bfseries\fontsize{9.8}{12.2}\selectfont\color{hcInk}}{\hc@subsecnum{\thesubsection}}{0pt}{}
  \titleformat{\subsubsection}[runin]{\sffamily\bfseries\fontsize{9}{11.2}\selectfont\color{hcPrimaryDeep}}{\hc@subsubsecnum{\thesubsubsection}}{0pt}{}[.]
  \titleformat{\paragraph}[runin]{\sffamily\bfseries\fontsize{9}{11.2}\selectfont\color{hcInk}}{}{0pt}{}[.]
  \titlespacing*{\section}{0pt}{10pt plus 2pt minus 2pt}{4pt plus 1pt}
  \titlespacing*{\subsection}{0pt}{8pt plus 2pt minus 1pt}{3pt plus 1pt}
\fi

