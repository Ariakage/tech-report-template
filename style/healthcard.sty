%% Author declaration: \hcauthor[affil/notes]{Full Name}{ORCID-or-empty}
\newcommand{\hcauthor}[3][]{%
  \global\advance\hc@authorcount by 1\relax
  \ifnum\hc@authorcount>1\relax
    \gappto\hc@authors@render{\hspace{0.85em}}%
    \gappto\hc@authors@plain{, }%
  \fi
  \gappto\hc@authors@render{%
    \mbox{%
      {\sffamily\bfseries\color{hcInk}#2}%
      \ifstrempty{#1}{}{\textsuperscript{\sffamily\color{hcPrimaryDeep}#1}}%
      \hcorcid{#3}%
    }%
  }%
  \gappto\hc@authors@plain{#2}%
  \ifstrempty{#3}{}{%
    \global\advance\hc@orcidcount by 1\relax
    \gappto\hc@authors@orcidlist{%
