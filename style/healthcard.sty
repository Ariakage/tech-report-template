%% =============================================================================
%% style/healthcard.sty — Pastel Health-Card / Header-Card Academic Paper Style
%% =============================================================================
%% Default Theme : #5BCEFA (Sky Cyan), #F5A9B8 (Blossom Pink), #FFFFFF (White)
%%                 + 4 built-in themes (ocean, sage, lavender, mono) & one-line
%%                 custom hex theming via \hcsettheme{primary=..., accent=...}.
%% Engine        : 100% pdfLaTeX / arXiv safe (Type 1 fonts + pure TikZ vector).
%%                 Uses ONLY TeX Live built-in packages. ZERO -shell-escape.
%% Layout        : Native ACM acmart ([sigconf, nonacm] two-column or 1-column),
%%                 plus standard article class fallback. All layout widths use
%%                 relative units (\textwidth, \linewidth).
%% =============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style/healthcard}[2026/11/21 v1.1 Pastel Health-Card Paper Template]

%% -----------------------------------------------------------------------------
%% 1. Package Options (via xkeyval, built into TeX Live & acmart)
%% -----------------------------------------------------------------------------
\RequirePackage{xkeyval}
\RequirePackage{etoolbox}
\RequirePackage{xstring}

\newif\ifhc@orcid@official \hc@orcid@officialfalse
\newif\ifhc@ribbon@gradient \hc@ribbon@gradienttrue
\newif\ifhc@ribbon@stripe \hc@ribbon@stripefalse
\newif\ifhc@ribbon@none \hc@ribbon@nonefalse
\newif\ifhc@accent@flip \hc@accent@flipfalse
\newif\ifhc@header@clean \hc@header@cleanfalse
\newif\ifhc@acmart \hc@acmartfalse
\def\hc@themename{pastel}

\@ifclassloaded{acmart}{\hc@acmarttrue}{\hc@acmartfalse}

\DeclareOptionX{theme}[pastel]{\def\hc@themename{#1}}
\DeclareOptionX{orcid}[brand]{%
  \IfStrEq{#1}{official}{\hc@orcid@officialtrue}{\hc@orcid@officialfalse}%
}
\DeclareOptionX{ribbon}[gradient]{%
  \hc@ribbon@gradientfalse\hc@ribbon@stripefalse\hc@ribbon@nonefalse
  \IfStrEq{#1}{stripe}{\hc@ribbon@stripetrue}{%
    \IfStrEq{#1}{none}{\hc@ribbon@nonetrue}{\hc@ribbon@gradienttrue}%
  }%
}
\DeclareOptionX{accent}[blue]{%
  \IfStrEq{#1}{pink}{\hc@accent@fliptrue}{\hc@accent@flipfalse}%
}
\DeclareOptionX{headerstyle}[layered]{%
  \IfStrEq{#1}{clean}{\hc@header@cleantrue}{\hc@header@cleanfalse}%
}
\ProcessOptionsX\relax

%% -----------------------------------------------------------------------------
%% 2. Standard TeX Live Built-in Packages (Zero -shell-escape, Zero local TTF/OTF)
%% -----------------------------------------------------------------------------
\ifhc@acmart
  %% acmart already loads: geometry, xcolor, hyperref, booktabs, caption,
