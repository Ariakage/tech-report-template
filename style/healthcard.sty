%% Author declaration: \hcauthor[affil/notes]{Full Name}{ORCID-or-empty}
\newcommand{\hcauthor}[3][]{%
  \global\advance\hc@authorcount by 1\relax
  \ifnum\hc@authorcount>1\relax
    \gappto\hc@authors@render{\hspace{0.85em}}%
    \gappto\hc@authors@plain{, }%
  \fi
  \gappto\hc@authors@render{%
    \mbox{%
      {\sffamily\bfseries\color{hcInk}#2}%
      \ifstrempty{#1}{}{\textsuperscript{\sffamily\color{hcPrimaryDeep}#1}}%
      \hcorcid{#3}%
    }%
  }%
  \gappto\hc@authors@plain{#2}%
  \ifstrempty{#3}{}{%
    \global\advance\hc@orcidcount by 1\relax
    \gappto\hc@authors@orcidlist{%
      \hc@orcidrow{#2}{#3}%
    }%
  }%
}

%% Affiliation declaration: \hcaffiliation[idx]{Institution Name}
\newcommand{\hcaffiliation}[2][]{%
  \global\advance\hc@affilcount by 1\relax
  \ifnum\hc@affilcount>1\relax
    \gappto\hc@affiliations{\hspace{1.05em}}%
  \fi
  \gappto\hc@affiliations{%
    \mbox{%
      \ifstrempty{#1}{}{\textsuperscript{\sffamily\bfseries\color{hcPrimaryDeep}#1}\hspace{0.15em}}%
      {\sffamily\color{hcMuted}#2}%
    }%
  }%
}

%% Author notes & Correspondence
\newcommand{\hcauthornote}[1]{%
  \global\advance\hc@notecount by 1\relax
  \ifnum\hc@notecount>1\relax
    \gappto\hc@authornotes{\hspace{0.75em}\textcolor{hcPrimaryBorder}{\textperiodcentered}\hspace{0.75em}}%
  \fi
  \gappto\hc@authornotes{{\sffamily\color{hcMuted}#1}}%
}

\newcommand{\hcemail}[1]{\href{mailto:#1}{\nolinkurl{#1}}}
\newcommand{\hccorrespondence}[1]{\gdef\hc@correspondence{#1}}

%% Resource link shorthand helpers
\newcommand{\hcghlink}[1]{\href{https://github.com/#1}{#1}}
\newcommand{\hchflink}[1]{\href{https://huggingface.co/#1}{#1}}

