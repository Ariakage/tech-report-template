\newcommand{\hc@resolveicon}[1]{%
  \IfStrEqCase{#1}{%
    {heart}{\faIcon{heartbeat}}%
    {shield}{\faIcon{shield-alt}}%
    {bolt}{\faIcon{bolt}}%
    {check}{\faIcon{check-circle}}%
    {chart}{\faIcon{chart-line}}%
    {clock}{\faIcon{clock}}%
    {cpu}{\faIcon{microchip}}%
    {database}{\faIcon{database}}%
    {star}{\faIcon{star}}%
    {globe}{\faIcon{globe}}%
    {memory}{\faIcon{memory}}%
    {tachometer}{\faIcon{tachometer-alt}}%
  }[#1]%
}

\newcommand{\hcmetriccard}[5]{%
  \IfStrEq{#1}{pink}{%
    \def\hc@mc@border{hcAccentBorder}%
    \def\hc@mc@soft{hcAccentSoft}%
    \def\hc@mc@bg{hcAccentBg}%
    \def\hc@mc@deep{hcAccentDeep}%
    \def\hc@mc@dark{hcAccentDark}%
    \def\hc@mc@bar{hcAccent}%
  }{%
    \IfStrEq{#1}{accent}{%
      \def\hc@mc@border{hcAccentBorder}%
      \def\hc@mc@soft{hcAccentSoft}%
      \def\hc@mc@bg{hcAccentBg}%
      \def\hc@mc@deep{hcAccentDeep}%
      \def\hc@mc@dark{hcAccentDark}%
      \def\hc@mc@bar{hcAccent}%
    }{%
      \def\hc@mc@border{hcPrimaryBorder}%
      \def\hc@mc@soft{hcPrimarySoft}%
      \def\hc@mc@bg{hcPrimaryBg}%
      \def\hc@mc@deep{hcPrimaryDeep}%
      \def\hc@mc@dark{hcPrimaryDark}%
      \def\hc@mc@bar{hcPrimary}%
    }%
  }%
  \begin{tcolorbox}[
    enhanced,
    width=\linewidth,
    colback=hcSurface,
    colframe=\hc@mc@border,
    boxrule=0.65pt,
    arc=7pt,
    outer arc=7pt,
    left=8pt, right=8pt, top=8pt, bottom=7pt,
    boxsep=0pt,
    before skip=0pt, after skip=0pt,
    overlay={%
      \begin{scope}
        \clip[rounded corners=7pt] (frame.south west) rectangle (frame.north east);
        \fill[\hc@mc@bar] ([yshift=-2.3pt]frame.north west) rectangle (frame.north east);
      \end{scope}
    }
  ]
    \raggedright
    {\sffamily\fontsize{6.6}{8}\selectfont\bfseries\color{hcMuted}%
      \tcbox[
        on line, enhanced,
        colback=\hc@mc@soft, colframe=\hc@mc@soft,
        boxrule=0pt, arc=3.5pt,
        boxsep=0pt, left=3pt, right=3pt, top=2pt, bottom=2pt,
        nobeforeafter, tcbox raise base
      ]{\color{\hc@mc@deep}\hc@resolveicon{#2}}\hspace{0.35em}\MakeUppercase{#3}\par}%
    \vskip 4.5pt
    {\sffamily\bfseries\fontsize{14}{15.5}\selectfont\color{\hc@mc@dark}#4\par}%
    \vskip 3.5pt
    \tcbox[
      on line, enhanced,
      colback=\hc@mc@bg, colframe=\hc@mc@border!75!hcSurface,
      boxrule=0.35pt, arc=3pt,
      boxsep=0pt, left=4pt, right=4pt, top=1.4pt, bottom=1.4pt,
      nobeforeafter, tcbox raise base
    ]{\sffamily\fontsize{6.7}{7.8}\selectfont\color{\hc@mc@deep}#5}%
  \end{tcolorbox}%
}

