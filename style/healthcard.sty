%% Rebuild gradient shadings & ORCID color whenever a theme is applied
\newcommand{\hc@refresh@theme@assets}{%
  \ifhc@accent@flip
    \colorlet{hc@tmp}{hcPrimary}
    \colorlet{hcPrimary}{hcAccent}
    \colorlet{hcAccent}{hc@tmp}
    \colorlet{hc@tmp}{hcPrimaryBg}
    \colorlet{hcPrimaryBg}{hcAccentBg}
    \colorlet{hcAccentBg}{hc@tmp}
    \colorlet{hc@tmp}{hcPrimarySoft}
    \colorlet{hcPrimarySoft}{hcAccentSoft}
    \colorlet{hcAccentSoft}{hc@tmp}
    \colorlet{hc@tmp}{hcPrimaryBorder}
    \colorlet{hcPrimaryBorder}{hcAccentBorder}
    \colorlet{hcAccentBorder}{hc@tmp}
    \colorlet{hc@tmp}{hcPrimaryDeep}
    \colorlet{hcPrimaryDeep}{hcAccentDeep}
    \colorlet{hcAccentDeep}{hc@tmp}
    \colorlet{hc@tmp}{hcPrimaryDark}
    \colorlet{hcPrimaryDark}{hcAccentDark}
    \colorlet{hcAccentDark}{hc@tmp}
  \fi
  %% Backwards-compatible aliases (automatically follow active theme!)
  \colorlet{hcBlue}{hcPrimary}
  \colorlet{hcBlueBg}{hcPrimaryBg}
  \colorlet{hcBlueSoft}{hcPrimarySoft}
  \colorlet{hcBlueBorder}{hcPrimaryBorder}
  \colorlet{hcBlueDeep}{hcPrimaryDeep}
  \colorlet{hcBlueDark}{hcPrimaryDark}
  \colorlet{hcPink}{hcAccent}
  \colorlet{hcPinkBg}{hcAccentBg}
  \colorlet{hcPinkSoft}{hcAccentSoft}
  \colorlet{hcPinkBorder}{hcAccentBorder}
  \colorlet{hcPinkDeep}{hcAccentDeep}
  \colorlet{hcPinkDark}{hcAccentDark}
  \colorlet{hcSecondary}{hcAccent}
  \colorlet{hcSecondaryBg}{hcAccentBg}
  \colorlet{hcSecondarySoft}{hcAccentSoft}
  \colorlet{hcSecondaryBorder}{hcAccentBorder}
  \colorlet{hcSecondaryDeep}{hcAccentDeep}
  \colorlet{hcSecondaryDark}{hcAccentDark}
  \colorlet{hcLinkBlue}{hcLinkColor}
  \colorlet{hcCiteBlue}{hcCiteColor}
  \colorlet{hcUrlPink}{hcUrlColor}
  %% ORCID icon color
  \ifhc@orcid@official
    \colorlet{orcidlogocol}{hcOrcidGreen}
  \else
    \colorlet{orcidlogocol}{hcPrimaryDeep}
  \fi
  %% Symmetric pastel gradient ribbon & running-header hairline rule
  \pgfdeclarehorizontalshading{hcRibbonGrad}{10bp}{%
    color(0bp)=(hcPrimary);
    color(24bp)=(hcAccent);
    color(50bp)=(hcSurface!85!hcPrimaryBg);
    color(76bp)=(hcAccent);
    color(100bp)=(hcPrimary)
  }%
  \pgfdeclarehorizontalshading{hcRuleGrad}{4bp}{%
    color(0bp)=(hcPrimary!80!hcSurface);
    color(50bp)=(hcAccent!85!hcSurface);
    color(100bp)=(hcPrimary!80!hcSurface)
  }%
}

