%% Custom hex theme override: \hcsettheme{primary=5BCEFA, accent=F5A9B8}
\define@key{hctheme}{primary}{\definecolor{hcPrimary}{HTML}{#1}}
\define@key{hctheme}{accent}{\definecolor{hcAccent}{HTML}{#1}}
\define@key{hctheme}{surface}{\definecolor{hcSurface}{HTML}{#1}}

\newcommand{\hcsettheme}[1]{%
  \setkeys{hctheme}{#1}%
  \colorlet{hcPrimaryBg}{hcPrimary!11!hcSurface}%
  \colorlet{hcPrimarySoft}{hcPrimary!24!hcSurface}%
  \colorlet{hcPrimaryBorder}{hcPrimary!60!hcSurface}%
  \colorlet{hcAccentBg}{hcAccent!12!hcSurface}%
  \colorlet{hcAccentSoft}{hcAccent!26!hcSurface}%
  \colorlet{hcAccentBorder}{hcAccent!65!hcSurface}%
  \colorlet{hcCanvas}{hcPrimary!4!hcSurface}%
  \colorlet{hcStripe}{hcPrimary!7!hcSurface}%
  \colorlet{hcLine}{hcPrimary!22!hcMuted!35!hcSurface}%
  \colorlet{hcPrimaryDark}{hcPrimary!35!hcInk}%
  \colorlet{hcPrimaryDeep}{hcPrimary!52!hcInk}%
  \colorlet{hcAccentDark}{hcAccent!32!hcInk}%
  \colorlet{hcAccentDeep}{hcAccent!48!hcInk}%
  \colorlet{hcLinkColor}{hcPrimary!50!hcInk}%
  \colorlet{hcCiteColor}{hcPrimary!56!hcInk}%
  \colorlet{hcUrlColor}{hcAccent!46!hcInk}%
  \hc@refresh@theme@assets
}

