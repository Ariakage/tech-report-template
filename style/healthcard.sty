%% 15.8 Pure LaTeX Code Card with Key-Line Highlighting (ZERO -shell-escape)
\def\hc@code@hlprimary{}
\def\hc@code@hlaccent{}

\lst@Key{hlprimary}{}{%
  \gdef\hc@code@hlprimary{}%
  \forcsvlist{\listgadd\hc@code@hlprimary}{#1}%
}
\lst@Key{hlaccent}{}{%
  \gdef\hc@code@hlaccent{}%
  \forcsvlist{\listgadd\hc@code@hlaccent}{#1}%
}
\lst@Key{hlblue}{}{%
  \gdef\hc@code@hlprimary{}%
  \forcsvlist{\listgadd\hc@code@hlprimary}{#1}%
}
\lst@Key{hlpink}{}{%
  \gdef\hc@code@hlaccent{}%
  \forcsvlist{\listgadd\hc@code@hlaccent}{#1}%
}

\lst@AddToHook{PreSet}{%
  \gdef\hc@code@hlprimary{}%
  \gdef\hc@code@hlaccent{}%
}

\newcommand{\hc@code@drawlinehl}[2]{%
  \rlap{%
    \hspace*{-3.5pt}%
    {\color{#1}\vrule width \dimexpr\linewidth+5.5pt\relax height 0.78\baselineskip depth 0.22\baselineskip}%
    \hspace*{-\dimexpr\linewidth+5.5pt\relax}%
    {\color{#2}\vrule width 1.8pt height 0.78\baselineskip depth 0.22\baselineskip}%
  }%
}

\lst@AddToHook{EveryPar}{%
  \xifinlist{\the\c@lstnumber}{\hc@code@hlprimary}{%
    \hc@code@drawlinehl{hcCodeHlOneBg}{hcCodeHlOneBar}%
  }{%
    \xifinlist{\the\c@lstnumber}{\hc@code@hlaccent}{%
      \hc@code@drawlinehl{hcCodeHlTwoBg}{hcCodeHlTwoBar}%
    }{}%
  }%
  \color{hcCodeText}%
}

\lstdefinestyle{hcCodeStyle}{%
  basicstyle=\ttfamily\fontsize{7.0}{9.6}\selectfont\color{hcCodeText},
  keywordstyle=\bfseries\color{hcCodeKw},
  keywordstyle=[2]\color{hcCodeKwTwo},
  stringstyle=\color{hcCodeStr},
  commentstyle=\color{hcCodeCom},
  numberstyle=\sffamily\fontsize{6.6}{8}\selectfont\color{hcCodeNum},
  numbers=left,
  numbersep=7pt,
  stepnumber=1,
  breaklines=true,
  breakatwhitespace=true,
  showstringspaces=false,
  tabsize=2,
  keepspaces=true,
  columns=flexible,
  extendedchars=false,
  aboveskip=0pt,
  belowskip=0pt
}

\newtcblisting[auto counter]{hccode}[3][Code]{%
  enhanced,
  breakable,
  lines before break=5,
  width=\linewidth,
  hc@code@skin,
  left=17pt, right=5.5pt, top=4.5pt, bottom=4.5pt,
  toptitle=3.2pt, bottomtitle=3.2pt,
  fonttitle=\raggedright\sffamily\bfseries\fontsize{7.8}{9.4}\selectfont,
  title={\hc@code@dots\hc@lbl@listing~\thetcbcounter: #1},
  listing only,
  listing options={style=hcCodeStyle, #2},
  before skip=6.5pt,
  after skip=6.5pt,
  #3
}

