%% 15.10 Native PGFPlots Theme (Relative Widths, Theme-Aware Palette)
\pgfplotscreateplotcyclelist{hcPlotCycle}{%
  {hcPrimaryDeep, line width=1.45pt, mark=*, mark size=2.1pt, mark options={fill=hcSurface, draw=hcPrimaryDeep, line width=1pt}},%
  {hcAccentDeep, line width=1.45pt, mark=square*, mark size=2.0pt, mark options={fill=hcSurface, draw=hcAccentDeep, line width=1pt}},%
  {\hc@plotthree@border, line width=1.35pt, dashed, mark=triangle*, mark size=2.3pt, mark options={fill=\hc@plotthree@fill, draw=\hc@plotthree@border, line width=0.8pt}},%
