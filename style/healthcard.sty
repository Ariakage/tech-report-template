%% -----------------------------------------------------------------------------
%% 5. ORCID Helpers (Pure pdfLaTeX Vector via orcidlink)
%% -----------------------------------------------------------------------------
\DeclareRobustCommand{\hcorcid}[1]{%
  \ifstrempty{#1}{}{%
    \texorpdfstring{\nobreak\hspace{0.22em}\raisebox{-0.06ex}{\orcidlink{#1}}}{}%
  }%
}
\DeclareRobustCommand{\hcorcidfull}[1]{%
  \ifstrempty{#1}{}{%
    \href{https://orcid.org/#1}{\raisebox{-0.06ex}{\orcidlogo}\hspace{0.28em}\texttt{\footnotesize #1}}%
  }%
}

%% -----------------------------------------------------------------------------
%% 6. Logo Slot System (Page 1 Dual Logo Slots + Pages 2+ 10pt Mini Logo)
%% -----------------------------------------------------------------------------
%% Default minimalist built-in vector marks (pure TikZ, zero external assets)
\newcommand{\hc@default@brandmark}{%
  \begin{tikzpicture}[baseline=0.25ex]
    \fill[hcPrimarySoft, rounded corners=3.5pt] (0,0) rectangle (16pt,16pt);
    \draw[hcPrimaryBorder, line width=0.55pt, rounded corners=3.5pt] (0,0) rectangle (16pt,16pt);
    \draw[hcPrimaryDark, line width=0.95pt, line cap=round, line join=round]
      (2.2pt,8pt) -- (5.0pt,8pt) -- (6.6pt,12.2pt) -- (9.0pt,3.8pt) -- (10.8pt,8pt) -- (13.8pt,8pt);
    \fill[hcAccent] (13.8pt,8pt) circle (1.35pt);
  \end{tikzpicture}%
}

%% Default 10pt monochrome miniature logo for Pages 2+ top-left running header
\newcommand{\hc@default@headerlogo}{%
  \begin{tikzpicture}[baseline=0.15ex]
    \draw[hcMuted, line width=0.65pt, rounded corners=2pt] (0,0) rectangle (10pt,10pt);
    \draw[hcMuted, line width=0.75pt, line cap=round, line join=round]
      (1.5pt,5pt) -- (3.3pt,5pt) -- (4.3pt,7.6pt) -- (5.8pt,2.4pt) -- (6.8pt,5pt) -- (8.5pt,5pt);
  \end{tikzpicture}%
}

%% Built-in helper to render a crisp vector logo pill if user wants quick text+mark
\newcommand{\hcvectorbadge}[2]{%
  \begin{tikzpicture}[baseline=0.25ex]
    \node[
      inner xsep=5pt, inner ysep=2.6pt,
      minimum height=17pt,
      rounded corners=4pt,
      fill=hcSurface,
      draw=hcLine,
      line width=0.55pt,
      font=\sffamily\bfseries\fontsize{7.4}{8.5}\selectfont,
      text=hcPrimaryDark
    ] {#1\hspace{0.35em}#2};
  \end{tikzpicture}%
}

